// Prisma Schema for Hampton Homes Australian Real Estate Platform
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  MARKETING_ADMIN
  OFFICE_MANAGER
  AGENT
  SUPPORT
  CUSTOMER
}

enum PropertyStatus {
  DRAFT
  COMING_SOON
  FOR_SALE
  FOR_RENT
  AUCTION
  UNDER_OFFER
  UNDER_CONTRACT
  SOLD
  LEASED
  WITHDRAWN
  OFF_MARKET
}

enum ListingType {
  RESIDENTIAL_SALE
  RESIDENTIAL_RENT
  COMMERCIAL_SALE
  COMMERCIAL_RENT
  PROJECT
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  APPOINTMENT_BOOKED
  APPRAISAL_COMPLETED
  NEGOTIATING
  WON
  LOST
  ARCHIVED
}

enum LeadType {
  BUYER
  SELLER
  TENANT
  LANDLORD
  APPRAISAL
  PROPERTY_ENQUIRY
  INSPECTION
  COMMERCIAL
  GENERAL
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  WARNING
  FAILED
}

enum MediaType {
  PHOTO
  FLOORPLAN
  VIDEO
  VIRTUAL_TOUR
  DOCUMENT
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  isActive         Boolean          @default(true)
  isEmailVerified  Boolean          @default(false)
  mfaEnabled       Boolean          @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  userRoles        UserRole[]
  customerProfile  CustomerProfile?
  agentProfile     Agent?
  auditLogs        AuditLog[]       @relation("ActorAuditLogs")

  @@index([email])
  @@index([isActive])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. "property.view", "lead.assign"
  name        String
  module      String
  description String?

  roles       RolePermission[]

  @@index([code])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model CustomerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  preferences    Json?     @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  favourites     Favourite[]
  savedSearches  SavedSearch[]
  recentlyViewed RecentlyViewed[]
}

model Office {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  address     String
  suburb      String
  state       String     @default("NSW")
  postcode    String
  phone       String
  email       String
  description String?    @db.Text
  isHeadOffice Boolean   @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agents      Agent[]
  leads       Lead[]
}

model Agent {
  id           String     @id @default(uuid())
  userId       String     @unique
  officeId     String
  bio          String?    @db.Text
  photoUrl     String?
  phone        String?
  mobile       String?
  position     String     @default("Sales Agent")
  displayOrder Int        @default(0)
  isFeatured   Boolean    @default(false)
  isPublic     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  office       Office     @relation(fields: [officeId], references: [id])
  assignedLeads Lead[]    @relation("AgentLeads")
  listings     PropertyAgent[]
}

model Property {
  id             String      @id @default(uuid())
  streetNumber   String?
  streetName     String
  suburb         String
  state          String      @default("NSW")
  postcode       String
  country        String      @default("Australia")
  latitude       Float?
  longitude      Float?
  bedrooms       Int?
  bathrooms      Int?
  carSpaces      Int?
  landAreaSqm    Float?
  buildingAreaSqm Float?
  propertyType   String      // House, Apartment, Townhouse, Villa, Land, Commercial
  mriId          String?     @unique
  mriProvider    String?     // "VAULT" | "PROPERTY_TREE"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  listings       Listing[]
  media          PropertyMedia[]
  features       PropertyFeature[]
  websiteOverride PropertyWebsiteOverride?
  mappings       ExternalEntityMapping[]
  leads          Lead[]

  @@index([suburb, state, postcode])
  @@index([mriId])
  @@index([propertyType])
  @@index([createdAt])
}

model Listing {
  id             String          @id @default(uuid())
  propertyId     String
  listingType    ListingType     @default(RESIDENTIAL_SALE)
  status         PropertyStatus  @default(FOR_SALE)
  headline       String
  description    String          @db.Text
  priceDisplay   String          // e.g. "$1,250,000" or "Contact Agent"
  priceNumeric   Float?
  auctionDate    DateTime?
  auctionLocation String?
  availableDate  DateTime?
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agents         PropertyAgent[]
  inspections    PropertyInspection[]
  enquiries      Enquiry[]

  @@index([status, listingType])
  @@index([propertyId])
  @@index([priceNumeric])
  @@index([publishedAt])
  @@index([createdAt])
}

model PropertyAgent {
  listingId  String
  agentId    String
  isPrimary  Boolean  @default(true)

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([listingId, agentId])
  @@index([listingId])
  @@index([agentId])
}

model PropertyMedia {
  id           String    @id @default(uuid())
  propertyId   String
  url          String
  mediaType    MediaType @default(PHOTO)
  title        String?
  displayOrder Int       @default(0)
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, mediaType])
  @@index([propertyId, isPrimary])
  @@index([propertyId, displayOrder])
}

model PropertyFeature {
  id           String   @id @default(uuid())
  propertyId   String
  featureName  String
  category     String?  // Interior, Exterior, Eco, Heating/Cooling

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyInspection {
  id           String   @id @default(uuid())
  listingId    String
  startTime    DateTime
  endTime      DateTime
  notes        String?
  createdAt    DateTime @default(now())

  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model PropertyWebsiteOverride {
  id                  String   @id @default(uuid())
  propertyId          String   @unique
  seoTitle            String?
  seoDescription      String?
  customHeadline      String?
  customBadge         String?
  isFeaturedHomepage  Boolean  @default(false)
  isFeaturedSearch    Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model ExternalEntityMapping {
  id                String   @id @default(uuid())
  provider          String   // "VAULT" | "PROPERTY_TREE"
  entityType        String   // "PROPERTY" | "AGENT" | "OFFICE"
  externalId        String
  internalId        String
  propertyId        String?
  externalUpdatedAt DateTime?
  lastSyncedAt      DateTime @default(now())
  syncHash          String?

  property          Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([provider, entityType, externalId])
}

model SyncJob {
  id               String     @id @default(uuid())
  provider         String
  jobType          String     // INCREMENTAL | FULL_RECONCILIATION
  status           SyncStatus @default(PENDING)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  recordsProcessed Int        @default(0)
  recordsUpdated   Int        @default(0)
  recordsFailed    Int        @default(0)
  errorMessage     String?

  logs             SyncLog[]
  errors           SyncError[]
}

model SyncLog {
  id         String   @id @default(uuid())
  syncJobId  String
  entityType String
  externalId String
  action     String   // CREATED | UPDATED | SKIPPED
  message    String?
  createdAt  DateTime @default(now())

  syncJob    SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
}

model SyncError {
  id           String   @id @default(uuid())
  syncJobId    String
  entityType   String
  externalId   String
  errorMessage String   @db.Text
  rawPayload   Json?
  retryCount   Int      @default(0)
  isResolved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  syncJob      SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String     @id @default(uuid())
  name          String
  email         String
  phone         String
  leadType      LeadType   @default(PROPERTY_ENQUIRY)
  status        LeadStatus @default(NEW)
  priority      String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  source        String     @default("WEBSITE")
  notes         String?    @db.Text
  officeId      String?
  agentId       String?
  propertyId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  office        Office?    @relation(fields: [officeId], references: [id])
  assignedAgent Agent?     @relation("AgentLeads", fields: [agentId], references: [id])
  property      Property?  @relation(fields: [propertyId], references: [id])
  activities    LeadActivity[]
  enquiries     Enquiry[]

  @@index([status, createdAt])
  @@index([agentId])
  @@index([officeId])
  @@index([email])
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  actionType  String   // CREATED, ASSIGNED, STATUS_CHANGE, NOTE_ADDED
  description String
  actorName   String
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id           String   @id @default(uuid())
  listingId    String
  leadId       String?
  name         String
  email        String
  phone        String
  message      String   @db.Text
  mriPushed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lead         Lead?    @relation(fields: [leadId], references: [id])

  @@index([listingId])
  @@index([leadId])
}

model Favourite {
  id                String          @id @default(uuid())
  customerProfileId String
  propertyId        String
  createdAt         DateTime        @default(now())

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
  @@index([propertyId])
}

model SavedSearch {
  id                String          @id @default(uuid())
  customerProfileId String
  name              String
  criteria          Json
  alertFrequency    String          @default("DAILY") // IMMEDIATELY, DAILY, WEEKLY
  isEnabled         Boolean         @default(true)
  createdAt         DateTime        @default(now())

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
}

model RecentlyViewed {
  id                String          @id @default(uuid())
  customerProfileId String
  propertyId        String
  viewedAt          DateTime        @default(now())

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
  @@index([propertyId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorEmail    String?
  action        String
  entity        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  correlationId String?
  createdAt     DateTime @default(now())

  actor         User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorEmail])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  category    String   @default("GENERAL") // GENERAL, WEBSITE, PROPERTIES, SEARCH, LEADS, NOTIFICATIONS, SEO, INTEGRATIONS
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// ─── Integration Hub Enums ───────────────────────────────────────────────────

enum IntegrationStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
  PENDING_SETUP
}

enum DocumentStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  COMPLETED
  DECLINED
  EXPIRED
}

enum AppointmentType {
  APPRAISAL
  INSPECTION
  VIEWING
  AUCTION
  FOLLOW_UP
  MEETING
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PropertyInsightVisibility {
  INTERNAL_ONLY
  AGENT_ONLY
  MANAGEMENT_ONLY
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

enum ContactMatchAction {
  PENDING
  MERGED
  KEPT_SEPARATE
  DISMISSED
}

// ─── Integration Hub Models ──────────────────────────────────────────────────

/// Stores vendor integration configuration, status, and encrypted credentials
model IntegrationProviderConfig {
  id               String            @id @default(uuid())
  provider         String            @unique // HOMEPASS | FLK | CORELOGIC | PROPERTYME | GOOGLE | MICROSOFT | APPLE | MRI_VAULT | MRI_PROPERTY_TREE
  displayName      String
  status           IntegrationStatus @default(PENDING_SETUP)
  isEnabled        Boolean           @default(false)
  credentialsMasked Json?            // { apiKey: "••••1234", webhookSecret: "••••abcd" }
  credentialsEnc   String?           @db.Text // AES-256-GCM encrypted JSON blob
  featureFlags     Json?             @default("{}") // { syncContacts: true, syncCalendar: false }
  priority         Int               @default(0) // Source-of-truth priority order
  lastHealthCheckAt DateTime?
  lastSyncAt       DateTime?
  webhookUrl       String?
  webhookSecret    String?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([provider])
  @@index([status])
}

/// OAuth 2.0 server-side token storage for Google, Microsoft, PropertyMe, Homepass
model ExternalAccountConnection {
  id              String   @id @default(uuid())
  agentId         String
  provider        String   // GOOGLE | MICROSOFT | PROPERTYME | HOMEPASS
  externalUserId  String?
  externalEmail   String?
  accessToken     String?  @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  scope           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, provider])
  @@index([agentId])
  @@index([provider])
}

/// Maps internal Lead/Agent IDs to external vendor contact IDs
model ContactExternalLink {
  id            String   @id @default(uuid())
  internalType  String   // LEAD | AGENT | CUSTOMER
  internalId    String
  provider      String   // GOOGLE | MICROSOFT | HOMEPASS | PROPERTYME | APPLE
  externalId    String
  syncedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([internalType, internalId, provider])
  @@index([internalId])
}

/// Agent calendar connection settings for Google/MS Outlook sync
model CalendarConnection {
  id              String   @id @default(uuid())
  agentId         String
  provider        String   // GOOGLE | MICROSOFT | APPLE
  calendarId      String?  // External calendar ID
  calendarName    String?
  isEnabled       Boolean  @default(true)
  syncDirection   String   @default("BIDIRECTIONAL") // PUSH | PULL | BIDIRECTIONAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, provider])
  events          ExternalCalendarEvent[]
}

/// Synced calendar event mapping to prevent duplicates
model ExternalCalendarEvent {
  id                  String   @id @default(uuid())
  calendarConnectionId String
  internalAppointmentId String?
  externalEventId     String
  externalProvider    String
  syncedAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt

  calendarConnection  CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)

  @@unique([calendarConnectionId, externalEventId])
  @@index([internalAppointmentId])
}

/// Unified appointment model for Appraisals, Inspections, Viewings, Auctions
model Appointment {
  id              String            @id @default(uuid())
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  title           String
  description     String?           @db.Text
  startTime       DateTime
  endTime         DateTime
  locationAddress String?
  propertyId      String?
  agentId         String?
  leadId          String?
  homepassEventId String?           // Homepass external event ID
  icsExported     Boolean           @default(false)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type, status])
  @@index([propertyId])
  @@index([agentId])
  @@index([startTime])
}

/// Vendor-neutral digital agreement model (FLK it over)
model Document {
  id              String         @id @default(uuid())
  type            String         // SALE_CONTRACT | TENANCY_AGREEMENT | LEASE_RENEWAL | OTHER
  status          DocumentStatus @default(DRAFT)
  title           String
  propertyId      String?
  agentId         String?
  leadId          String?
  signerName      String?
  signerEmail     String?
  sentAt          DateTime?
  viewedAt        DateTime?
  signedAt        DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  externalLinks   DocumentExternalLink[]

  @@index([status])
  @@index([propertyId])
  @@index([agentId])
}

/// FLK it over external document ID mapping
model DocumentExternalLink {
  id              String   @id @default(uuid())
  documentId      String
  provider        String   // FLK
  externalId      String   // FLK document/envelope ID
  externalUrl     String?
  syncedAt        DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, provider])
  @@unique([provider, externalId])
}

/// CoreLogic/RP Data licensed property intelligence record (INTERNAL/AGENT use only)
model PropertyInsight {
  id               String                    @id @default(uuid())
  propertyId       String?
  addressFull      String
  suburb           String?
  state            String?
  postcode         String?
  estimatedValue   Float?
  estimatedValueLow Float?
  estimatedValueHigh Float?
  lastSaleDate     DateTime?
  lastSalePrice    Float?
  daysOnMarket     Int?
  comparableSales  Json?                     // Array of recent comparable sales
  rentalEstimate   Float?
  landValue        Float?
  zoning           String?
  visibility       PropertyInsightVisibility @default(INTERNAL_ONLY)
  source           String                    @default("CORELOGIC")
  fetchedAt        DateTime                  @default(now())
  expiresAt        DateTime?
  rawResponse      Json?

  @@index([propertyId])
  @@index([addressFull])
}

/// Incoming webhook event log from Homepass, FLK, PropertyMe
model WebhookEvent {
  id              String             @id @default(uuid())
  provider        String             // HOMEPASS | FLK | PROPERTYME
  eventType       String             // visitor.checkin | document.signed | tenancy.updated
  status          WebhookEventStatus @default(RECEIVED)
  correlationId   String?            @unique // Idempotency key from vendor
  signatureValid  Boolean?
  rawPayload      Json
  processedAt     DateTime?
  errorMessage    String?            @db.Text
  retryCount      Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
}

/// Duplicate contact review queue (Merge / Keep Separate)
model ContactMatchCandidate {
  id              String             @id @default(uuid())
  primaryType     String             // LEAD | AGENT | CUSTOMER
  primaryId       String
  matchType       String             // LEAD | AGENT | CUSTOMER
  matchId         String
  matchScore      Float              // 0.0 - 1.0 confidence score
  matchReason     String?            // Email match, Phone match, Name fuzzy
  action          ContactMatchAction @default(PENDING)
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime           @default(now())

  @@index([action])
  @@index([primaryId])
}
