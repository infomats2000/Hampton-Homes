# =============================================================================
# WHITE-LABEL AGENCY CONFIGURATION
# Copy this file to .env.local and fill in the client's details.
# For Cloud Run, store secrets in Secret Manager and configure non-secret values
# as Cloud Run environment variables.
# =============================================================================

# ─── App URL ─────────────────────────────────────────────────────────────────
# The full public URL of this deployment (no trailing slash)
APP_URL=https://www.youragency.com.au

# ─── Agency Identity ─────────────────────────────────────────────────────────
# Short name used in headings, hero text, page titles
NEXT_PUBLIC_AGENCY_NAME=Coastal Premier Real Estate

# Full legal company name for footer and compliance notices
NEXT_PUBLIC_AGENCY_LEGAL_NAME=Coastal Premier Real Estate Pty Ltd

# One-line tagline shown in the hero banner and SEO description
NEXT_PUBLIC_AGENCY_TAGLINE=The Northern Beaches' leading real estate specialists

# Australian Business Number (displayed in footer)
NEXT_PUBLIC_AGENCY_ABN=12 345 678 901

# State licence number (NSW Fair Trading / Consumer Affairs VIC / REBA WA etc.)
NEXT_PUBLIC_AGENCY_LICENCE=10012345

# Primary operating state (used for compliance notices)
NEXT_PUBLIC_AGENCY_STATE=NSW

# ─── Contact Details ─────────────────────────────────────────────────────────
# Phone number in standard format (for href="tel:" links)
NEXT_PUBLIC_AGENCY_PHONE=1300 123 456

# Phone number as displayed in the top bar (can include vanity notation)
NEXT_PUBLIC_AGENCY_PHONE_DISPLAY=1300 123 456

# General enquiries email address
NEXT_PUBLIC_AGENCY_EMAIL=hello@youragency.com.au

# Full head office address (displayed in footer and contact page)
NEXT_PUBLIC_AGENCY_HEAD_OFFICE_ADDRESS=Level 5, 12 The Corso, Manly NSW 2095

# Canonical website URL (used in OG tags and sitemap)
NEXT_PUBLIC_AGENCY_WEBSITE_URL=https://www.youragency.com.au

# ─── Branding & Colours ──────────────────────────────────────────────────────
# Primary colour (used for headings, buttons, links)
# Tip: This should be the agency's main brand colour
NEXT_PUBLIC_AGENCY_COLOR_PRIMARY=#0a192f

# Darker shade (used for admin sidebar, announcement bar background)
NEXT_PUBLIC_AGENCY_COLOR_PRIMARY_DARK=#071325

# Accent / highlight colour (used for badges, hover effects, icons)
NEXT_PUBLIC_AGENCY_COLOR_ACCENT=#c5a059

# Lighter accent (used for gradient highlights)
NEXT_PUBLIC_AGENCY_COLOR_ACCENT_LIGHT=#d4af37

# ─── Logo ─────────────────────────────────────────────────────────────────────
# Path to logo within /public folder (e.g. /logo.png), OR a CDN URL.
# Supported formats: PNG, JPG, SVG, WebP
# Recommended sizes: at least 200×200px for OG image; 400×200px for navbar logo
NEXT_PUBLIC_AGENCY_LOGO_URL=/logo.png

# Separate OG/Twitter card image if different from the logo
NEXT_PUBLIC_AGENCY_OG_IMAGE_URL=/og-image.png

# ─── SEO Overrides (optional — auto-generated from above if not set) ──────────
# NEXT_PUBLIC_AGENCY_SEO_TITLE_DEFAULT=Coastal Premier Real Estate | Sydney Property
# NEXT_PUBLIC_AGENCY_SEO_TITLE_TEMPLATE=%s | Coastal Premier Real Estate
# NEXT_PUBLIC_AGENCY_SEO_DESCRIPTION=Northern Beaches premium property specialists.

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "false" to completely hide a section (nav link + page) for this client
NEXT_PUBLIC_FEATURE_CUSTOMER_PORTAL=true
NEXT_PUBLIC_FEATURE_COMMERCIAL=true
NEXT_PUBLIC_FEATURE_PROJECTS=true
NEXT_PUBLIC_FEATURE_AUCTIONS=true
NEXT_PUBLIC_FEATURE_PROPERTY_MANAGEMENT=true
NEXT_PUBLIC_FEATURE_NEWS=true
NEXT_PUBLIC_FEATURE_SUBURB_GUIDES=true
NEXT_PUBLIC_FEATURE_PROPERTY_INTELLIGENCE=true
NEXT_PUBLIC_FEATURE_DOCUMENTS=true

# =============================================================================
# BACKEND / SERVER-SIDE CONFIGURATION (never expose to the browser)
# =============================================================================

# ─── Database (Neon Serverless PostgreSQL) ───────────────────────────────────
# Pooled connection string (for application queries / serverless runtime)
# Example: postgresql://[user]:[password]@[ep-xyz-pooler.region].aws.neon.tech/[neondb]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct / unpooled connection string (for Prisma CLI migrations / db push)
# Example: postgresql://[user]:[password]@[ep-xyz].region.aws.neon.tech/[neondb]?sslmode=require
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE
NEXTAUTH_URL=https://www.youragency.com.au

# Admin account email (used as the default super-admin login)
ADMIN_EMAIL=admin@youragency.com.au

# Required only when running `npm run db:seed`. Never reuse production passwords.
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ─── MRI Integration ──────────────────────────────────────────────────────────
# Set MRI_DEMO_MODE=false when the client has live MRI credentials
MRI_DEMO_MODE=true

# MRI Vault (Sales)
MRI_VAULT_BASE_URL=https://api.vault.mrisoftware.com
MRI_VAULT_API_KEY=
MRI_VAULT_AGENCY_ID=

# MRI Property Tree (Rentals)
MRI_PROPERTY_TREE_BASE_URL=https://api.propertytree.com
MRI_PROPERTY_TREE_API_KEY=

# ─── Integration Webhook Secrets ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
HOMEPASS_WEBHOOK_SECRET=
FLK_WEBHOOK_SECRET=
PROPERTYME_WEBHOOK_SECRET=

# Homepass API key (for open home check-in)
HOMEPASS_API_KEY=

# FLK it over API key (for digital documents)
FLK_API_KEY=

# CoreLogic / RP Data (for Property Intelligence module)
CORELOGIC_CLIENT_ID=
CORELOGIC_CLIENT_SECRET=

# PropertyMe API (for property management tenancy data)
PROPERTYME_API_KEY=
PROPERTYME_AGENCY_ID=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier available
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX

# "From" address for outgoing emails — must be a verified domain in Resend
EMAIL_FROM=noreply@youragency.com.au

# Google Cloud Storage bucket for public property listing images
PROPERTY_IMAGE_BUCKET=infomats-realestate-property-images
